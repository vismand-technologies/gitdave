{
  "name": "gitdave",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Cross-platform desktop app to manage multiple GitHub profiles (Electron + React + TypeScript)",
  "author": {
    "name": "GitDave",
    "email": "you@example.com"
  },
  "homepage": "https://github.com/your-org/gitdave",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "start": "electron .",
    "start:headless": "xvfb-run -a electron .",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder -w nsis",
    "dist:win:msi": "electron-builder -w msi",
    "dist:win:all": "electron-builder -w nsis msi",
    "dist:win:x64": "electron-builder -w nsis msi --x64",
    "dist:win:arm64": "electron-builder -w nsis msi --arm64",
    "dist:mac": "electron-builder -m dmg",
    "dist:mac:universal": "electron-builder -m universal",
    "dist:linux": "electron-builder -l deb AppImage",
    "dist:linux:x64": "electron-builder -l deb AppImage --x64",
    "dist:linux:arm64": "electron-builder -l deb AppImage --arm64",
    "dist:linux:all": "electron-builder -l deb AppImage --x64 --arm64"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "css-loader": "7.1.2",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "html-webpack-plugin": "5.6.0",
    "postcss": "8.4.41",
    "postcss-loader": "8.1.1",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.7",
    "ts-loader": "9.5.1",
    "tslib": "2.6.3",
    "typescript": "5.5.4",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4"
  },
  "build": {
    "appId": "com.gitdave.app",
    "productName": "GitDave",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": {
        "appBundleId": "com.gitdave.app",
        "ascProvider": "${env.ASC_PROVIDER}"
      },
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] },
        { "target": "msi", "arch": ["x64", "arm64"] }
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "GitDave <you@example.com>",
      "icon": "build/icons/png",
      "target": [
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "AppImage", "arch": ["x64", "arm64"] }
      ]
    }
  }
}
